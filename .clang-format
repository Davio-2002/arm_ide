BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
AllowShortFunctionsOnASingleLine: Empty
InsertBraces: true
SpacesInParens: Custom
SpacesInParensOptions:
  InConditionalStatements: true
  InCStyleCasts: true
  InEmptyParentheses: false
  Other: true
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<(imgui|imgui_.*|TextEditor|GLFW/.*|unicorn/.*|misc/.*)\.h>'
    Priority: 1
  - Regex: '^<(app|core|gui)/.*>'
    Priority: 3
  - Regex: '.*'
    Priority: 2
